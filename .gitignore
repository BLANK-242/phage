.venv/
__pycache__/
*.pyc
.env
*.json
!package.json
.DS_Store
# Evaluation artifacts backing the reported figures — these must ship so a
# fresh clone can verify AUC/TPR/FPR and the tuned threshold. The blanket
# *.json above was aimed at local state, not committed evidence.
!data/*.json
# Python build / tooling artifacts (uv.lock IS committed — do not ignore it)
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Large external reference dump (regenerable from https://adk.dev/llms-full.txt)
docs/reference/adk-llms-full.txt

# Live demo render — regenerable and engine-dependent (goes stale). The demo is
# meant to be RUN. (One-time probe/matrix diagnostic evidence stays tracked.)
scripts/vaccinate_demo_output.txt

# Claude Code local state (settings.local.json + atomic-write temp files);
# keep room for a shared, committable settings.json
.claude/*
!.claude/settings.json

phage_traces*.db
# The public dashboard's trace fixture IS committed: it is the redacted copy the
# Cloud Run service serves, and without it the deployed image has no trace data.
# The rule above matches it by name, so it needs an explicit exemption.
!dashboard/data/phage_traces_demo.db
docs/PHAGE_cc_prompt_*.md
.env.*
!.env.example
